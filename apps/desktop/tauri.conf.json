{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Commons",
  "version": "0.1.0",
  "identifier": "org.commons.desktop",
  "build": {
    "frontendDist": "../desktop-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../desktop-ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../desktop-ui"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Commons",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "label": "main",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: commons-file: http://commons-file.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
