# Install as /etc/commons/commonsd.env (root:commons, mode 0640). Placeholders only here.
# Every COMMONS_* variable commonsd reads is listed. An empty or unset value means the default.

# The host's PostgreSQL 16 on port 5433, `commons` role and database. URL-encode the password,
# or generate a URL-safe one: openssl rand -hex 24
COMMONS_DATABASE_URL=postgres://commons:change-me@127.0.0.1:5433/commons

# Loopback only; nginx proxies commons.adarshnb.com here.
COMMONS_BIND=127.0.0.1:8090

# The URL clients and links use. TLS ends at nginx.
COMMONS_PUBLIC_URL=https://commons.adarshnb.com

# Uploaded files, under the unit's StateDirectory.
COMMONS_FILES_DIR=/var/lib/commons/files

# Who may create an account: open (anyone, the default), closed (no one) or invite (only with
# an invite link from a workspace owner or admin; the very first account on an empty server
# needs none). The old allowlist mode is gone: naming it stops commonsd at startup.
COMMONS_REGISTRATION=invite

# Test-box limits. 100 MiB per file; keep nginx's client_max_body_size (100m) in step.
COMMONS_MAX_FILE_BYTES=104857600
# 2 GiB of uploads per user.
COMMONS_USER_QUOTA_BYTES=2147483648

# Outgoing mail, for password reset. Unset here: reset requests are accepted and logged, but
# no email is sent and no link is kept, so password reset is off.
# Example: smtps://user:password@smtp.example.com:465
COMMONS_SMTP_URL=
# Sender for that mail. Default: Commons <no-reply@localhost>
COMMONS_MAIL_FROM=

# S3-compatible file storage instead of COMMONS_FILES_DIR; credentials, region and endpoint
# come from the AWS_* variables. Unset: files stay on local disk.
COMMONS_S3_BUCKET=

# Proxies whose X-Real-IP / X-Forwarded-For give the client address for login limits, besides
# loopback. nginx connects over loopback here, so leave it empty.
COMMONS_TRUSTED_PROXIES=

# Sign-in through an OIDC provider, found by discovery under the issuer. On only when all four
# are set. Register this redirect URI with the provider:
#   https://commons.adarshnb.com/v1/auth/oidc/callback
# For Google: issuer https://accounts.google.com, a "Web application" OAuth client.
COMMONS_OIDC_ISSUER=
COMMONS_OIDC_CLIENT_ID=
COMMONS_OIDC_CLIENT_SECRET=
# The provider's name on the button, as in "Continue with Google".
COMMONS_OIDC_NAME=

# Where "Download for Mac" on the invite page points. Default:
# https://github.com/digitaltracer/commons/releases/latest
COMMONS_APP_DOWNLOAD_URL=

# Log filter (tracing EnvFilter syntax). Logs go to the journal.
RUST_LOG=info
